import together

# Configurar la API Key (mejor usar una variable de entorno)
import os
os.environ["TOGETHER_API_KEY"] = "6d32b7529e457e37c3ba86863912877fa27b4b693f48fb5556756f10343df29c"

# JSON de ejemplo
json_data = '{"nombre": "Juan", "edad": 30, "ciudad": "San Salvador"}'

# Crear el prompt para el modelo de IA
prompt_propio = f"""
Tengo el siguiente JSON:
{json_data}

Por favor, descomponlo en clave-valor explicando el significado de cada elemento.
"""

# Hacer la solicitud a Together.AI
respuesta = together.Completion.create(
    model="mistralai/Mistral-7B-Instruct-v0.1",  # Modelo recomendado
    prompt=prompt_propio,
    max_tokens=100,
    temperature=0.7
)



# Mostrar la respuesta generada
print(respuesta.choices[0].text)
